<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@drawable/jianbian"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:treeView="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:gravity="center"
        android:id="@id/acbuwa_topbar"
        style="@style/topbar_bg">
        <TextView
            android:id="@id/tvTopbar"
            android:text="@string/app_name"
            style="@style/topbar_text" />
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/linearG"
            android:paddingLeft="6.0dip"
            android:paddingRight="6.0dip"
            android:visibility="visible"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0">
            <Gallery
                android:id="@id/gamePics"
                android:background="@drawable/textview_bg"
                android:layout_width="fill_parent"
                android:layout_height="210.0dip"
                android:spacing="14.0dip" />
            <TextView
                android:textSize="12.0sp"
                android:gravity="center"
                android:id="@id/tvGameText"
                android:paddingBottom="8.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:shadowColor="#FF000000"
                android:shadowDx="0.0"
                android:shadowDy="0.0"
                android:shadowRadius="2.5"
                android:background="@drawable/textview_bg"
                android:text="GameText" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="3.0dip"
            android:paddingRight="6.0dip"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0">
            <com.joyemu.fbaapp.MyGallery
                android:id="@id/myStateView"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="300.0dip" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <RadioGroup
                    android:orientation="horizontal"
                    android:background="@drawable/textview_bg"
                    android:id="@id/radioGroup1"
                    android:layout_width="fill_parent"
                    android:layout_height="36.0dip">
                    <RadioButton
                        android:textSize="13.0dip"
                        android:textColor="#FFFFFFFF"
                    android:shadowColor="#FF000000"
                    android:shadowDx="0.0"
                    android:shadowDy="0.0"
                    android:shadowRadius="2.2"
                        android:gravity="center"
                        android:id="@id/radioStates"
                        android:background="@drawable/eachradiobuttonuimiddle"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:checked="true"
                        android:button="@null"
                        android:text="@string/tabStates"
                        android:layout_weight="1.0" />
                    <RadioButton
                        android:textSize="13.0dip"
                        android:textColor="#FFFFFFFF"
                    android:shadowColor="#FF000000"
                    android:shadowDx="0.0"
                    android:shadowDy="0.0"
                    android:shadowRadius="2.2"
                        android:gravity="center"
                        android:id="@id/radioIpsTree"
                        android:background="@drawable/eachradiobuttonuimiddle"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:button="@null"
                        android:text="@string/tabIPS"
                        android:layout_weight="1.0" />
                    <RadioButton
                        android:textSize="13.0dip"
                        android:textColor="#FFFFFFFF"
                    android:shadowColor="#FF000000"
                    android:shadowDx="0.0"
                    android:shadowDy="0.0"
                    android:shadowRadius="2.2"
                        android:gravity="center"
                        android:id="@id/radioIpsSnap"
                        android:background="@drawable/eachradiobuttonuimiddle"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:button="@null"
                        android:text="@string/tabIPSthumb"
                        android:layout_weight="1.0" />
                </RadioGroup>
                <CheckBox
                    android:textColor="#FFFFFFFF"
                android:shadowColor="#FF000000"
                android:shadowDx="0.0"
                android:shadowDy="0.0"
                android:shadowRadius="2.0"
                    android:layout_gravity="center"
                    android:id="@id/cbApplyIPS"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12.0dip"
                    android:layout_marginRight="12.0dip"
                    android:text="@string/applyIPS"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <RelativeLayout
                android:id="@id/rr_bottom"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:id="@id/bottomLayout"
                    android:background="@drawable/textview_bg"
                    android:layout_width="fill_parent"
                    android:layout_height="45.0dip"
                    android:layout_alignParentBottom="true">
                    <Button
                        android:id="@id/btnGameStart"
                        android:background="@drawable/umeng_update_button_ok_bg_selector"
                        android:layout_width="fill_parent"
                        android:layout_height="35.0dip"
                        android:layout_marginLeft="50.0dip"
                        android:layout_marginRight="50.0dip"
                        android:text="@string/MenuRun" />
                </RelativeLayout>
                <FrameLayout
                    android:id="@id/framelayout_item"
                    android:background="@drawable/textview_bg"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_above="@id/bottomLayout"
                    android:layout_centerHorizontal="true">
                    <com.joyemu.treeview.TreeViewList
                        android:id="@id/mainTreeView"
                        android:background="@drawable/jianbian"
                        android:visibility="gone"
                        android:scrollbars="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:smoothScrollbar="true"
                        treeView:indicator_gravity="center|right" />
                    <GridView
                        android:gravity="center"
                        android:id="@id/gridview"
                        android:background="@drawable/jianbian"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:horizontalSpacing="10.0dip"
                        android:verticalSpacing="10.0dip"
                        android:stretchMode="columnWidth" />
                </FrameLayout>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>