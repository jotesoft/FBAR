<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/main"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/jianbian"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/ddddd"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@id/tvScreenRatio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/screenRatioTitle" />
            <Spinner
                android:id="@id/spinScreenRatio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@id/tvScreenFrameSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/screenFrameSkipTitle" />
            <Spinner
                android:id="@id/spinScreenFrameSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/gameSettingLinear"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.0dip">
        <Button
            android:shadowColor="#FF000000"
        android:shadowDx="0.0"
        android:shadowDy="0.0"
        android:shadowRadius="2.0"
        android:textColor="#FFFFFFFF"
        android:id="@id/btnScreenClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configClear"
            android:layout_weight="1.0" />
        <Button
            android:shadowColor="#FF000000"
        android:shadowDx="0.0"
        android:shadowDy="0.0"
        android:shadowRadius="2.0"
        android:textColor="#FFFFFFFF"
        android:id="@id/btnScreenSaveAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configToApp"
            android:layout_weight="1.0" />
        <Button
            android:shadowColor="#FF000000"
        android:shadowDx="0.0"
        android:shadowDy="0.0"
        android:shadowRadius="2.0"
        android:textColor="#FFFFFFFF"
        android:id="@id/btnScreenSaveGame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configToGame"
            android:layout_weight="1.0" />
    </LinearLayout>
</LinearLayout>