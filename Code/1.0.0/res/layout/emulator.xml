    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.joyemu.fba.FbaView
        android:id="@id/gameView"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <com.joyemu.newinput.GameOverlay
