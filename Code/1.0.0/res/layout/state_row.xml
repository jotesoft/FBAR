<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/RelativeLayoutStateItem"
    android:paddingLeft="12.0dip"
    android:paddingTop="2.0dip"
    android:paddingBottom="2.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/textview_bg"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/StateImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true" />
    <TextView
        android:textSize="14.0dip"
        android:textColor="#FFFFFFFF"
        android:shadowColor="#FF000000"
        android:shadowDx="0.0"
        android:shadowDy="0.0"
        android:shadowRadius="2.0"
        android:id="@id/StateName"
        android:paddingLeft="16.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/StateImage" />
    <TextView
        android:textSize="12.0dip"
        android:textColor="#FFFFFFFF"
        android:shadowColor="#FF000000"
        android:shadowDx="0.0"
        android:shadowDy="0.0"
        android:shadowRadius="2.0"
        android:id="@id/StateInfo"
        android:paddingLeft="16.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/StateImage"
        android:layout_below="@id/StateName" />
    <TextView
        android:textSize="5.0dip"
        android:id="@id/StatePath"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/StateImage"
        android:layout_below="@id/StateInfo" />
</RelativeLayout>