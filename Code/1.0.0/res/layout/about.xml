<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@android:color/white"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@id/acbuwa_topbar"
        style="@style/topbar_bg">
        <TextView
            android:id="@id/tvTopbar"
            android:text="@string/mainAbout"
            style="@style/topbar_text" />
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <ScrollView
            android:orientation="vertical"
            android:id="@id/scroll"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <FrameLayout
                    android:id="@id/headBg"
                    android:background="@drawable/banner"
                    android:layout_width="fill_parent"
                    android:layout_height="120.0dip">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@id/headIcon"
                            android:background="@drawable/ic_launcher_fba"
                            android:layout_width="60.0dip"
                            android:layout_height="60.0dip" />
                        <TextView
                            android:id="@id/fbaSlogan"
                            android:paddingLeft="5.0dip"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:text="FBAR Arcade\nClassic arcade gaming" />
                    </LinearLayout>
                </FrameLayout>
                <TextView
                    android:id="@id/txtFbaDespTitle"
                    android:paddingLeft="5.0dip"
                    android:paddingTop="20.0dip"
                    android:paddingBottom="5.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="FBAR Arcade: v1.0.0 \nInnitial public release"/>
                <LinearLayout
                    android:background="@drawable/line_devider"
                    android:layout_width="fill_parent"
                    android:layout_height="2.0dip" />
                <TextView
                    android:textSize="12.0sp"
                    android:id="@id/txtFbaDesp"
                    android:paddingLeft="20.0dip"
                    android:paddingTop="5.0dip"
                    android:paddingBottom="10.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="HelloWorld Fbnrdroid\n xxx\nggddo" 
                    android:visibility="gone"/>
                <LinearLayout
                    android:background="@drawable/line_devider"
                    android:layout_width="fill_parent"
                    android:layout_height="2.0dip" />
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/layoutBlog"
                    android:padding="5.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@id/blogIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/qrcode_soso"
                        android:scaleType="centerInside" />
                    <TextView
                        android:autoLink="all"
                        android:layout_gravity="center"
                        android:id="@id/blogDesp"
                        android:padding="5.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="For updates, visit www.jote.top" />
                </LinearLayout>
                <LinearLayout
                    android:background="@drawable/line_devider"
                    android:layout_width="fill_parent"
                    android:layout_height="2.0dip" />
                <TextView
                    android:textSize="12.0sp"
                    android:id="@id/txtFbaDesp"
                    android:paddingLeft="20.0dip"
                    android:paddingTop="5.0dip"
                    android:paddingBottom="10.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="New features and fixes \n20260909: New ui, improved compatibility \n20260410: Added 16:9 display ratio\n20260413: Improved IPS details display\n20260417: Increased instant save states to 20\n20260501: Added touch control for multiple players\n20260501: Reduced maximum audio latency to 0.2 seconds\n20260510: Fixed multi-player auto-fire issues in IGS games\n20260519: Increased combo keys to 10\n20260525: Added letter labels for common combo keys\n20260529: Increased built-in button skins to 6\n20260529: Improved portrait layout and coin button position\n20260611: Added hands-free auto-fire\n20260614: Fixed graphical corruption in specific games\n20260615: Added single-player selection in multi-player control" />
                <LinearLayout
                    android:background="@drawable/line_devider"
                    android:layout_width="fill_parent"
                    android:layout_height="1.0dip" />
                <TextView
                    android:textSize="12.0sp"
                    android:autoLink="all"
                    android:layout_gravity="center"
                    android:id="@id/txtQQ"
                    android:paddingLeft="10.0dip"
                    android:paddingTop="10.0dip"
                    android:paddingBottom="2.0dip"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="Community" />
                <TextView
                    android:textSize="12.0sp"
                    android:autoLink="all"
                    android:layout_gravity="center"
                    android:id="@id/txtUrl"
                    android:paddingLeft="10.0dip"
                    android:paddingBottom="10.0dip"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="https://github.com/jotesoft/fbar" />
                <Button
                    android:id="@id/btnFeedback"
                    android:background="@drawable/umeng_update_button_ok_bg_selector"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="35.0dip"
                    android:layout_marginLeft="50.0dip"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginRight="50.0dip"
                    android:text="@string/KeyFeedback" />
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</LinearLayout>