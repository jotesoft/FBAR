<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:padding="4.0dip">
    <GridView
        android:id="@id/gridview"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:horizontalSpacing="5.0dip"
        android:verticalSpacing="5.0dip"
        android:stretchMode="columnWidth" />
    <Button
        android:id="@+id/modernStateTest"
        android:visibility="gone"
        android:layout_width="96.0dip"
        android:layout_height="86.0dip"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6.0dip"
        android:minWidth="0.0dip"
        android:minHeight="0.0dip"
        android:padding="4.0dip"
        android:gravity="center"
        android:background="@drawable/textview_bg"
        android:drawableTop="@drawable/menu_netplay"
        android:drawablePadding="3.0dip"
        android:text="RB NetPlay&#10;experimantal"
        android:textSize="10.0sp"
        android:textColor="#FFFFFFFF"
        android:onClick="modernStateTestClick" />
</LinearLayout>
