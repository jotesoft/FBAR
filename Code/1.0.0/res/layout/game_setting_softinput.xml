<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@drawable/jianbian"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:shadowColor="#FF000000"
        android:shadowDx="0.0"
        android:shadowDy="0.0"
        android:shadowRadius="2.0"
        android:textColor="#FFFFFFFF"
        android:id="@id/btnStickLarge"
            android:background="@drawable/textview_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/StickLarge"
            android:layout_weight="1.0" />
        <TextView
            android:gravity="center"
            android:shadowColor="#FF000000"
        android:shadowDx="0.0"
        android:shadowDy="0.0"
        android:shadowRadius="2.0"
        android:textColor="#FFFFFFFF"
        android:id="@id/btnStickSmall"
            android:background="@drawable/textview_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/StickSmall"
            android:layout_weight="1.0" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <TextView
            android:gravity="center"
            android:shadowColor="#FF000000"
        android:shadowDx="0.0"
        android:shadowDy="0.0"
        android:shadowRadius="2.0"
        android:textColor="#FFFFFFFF"
        android:id="@id/btnBtnLarge"
            android:background="@drawable/textview_bg"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/BtnLarge"
            android:layout_weight="1.0" />
        <ImageView
            android:shadowColor="#FF000000"
        android:shadowDx="0.0"
        android:shadowDy="0.0"
        android:shadowRadius="2.0"
        android:textColor="#FFFFFFFF"
        android:id="@id/btnMove"
            android:background="@drawable/textview_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/move"
            android:scaleType="fitCenter"
            android:layout_weight="1.0" />
        <TextView
            android:gravity="center"
            android:shadowColor="#FF000000"
        android:shadowDx="0.0"
        android:shadowDy="0.0"
        android:shadowRadius="2.0"
        android:textColor="#FFFFFFFF"
        android:id="@id/btnBtnSmall"
            android:background="@drawable/textview_bg"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/BtnSmall"
            android:layout_weight="1.0" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:shadowColor="#FF000000"
        android:shadowDx="0.0"
        android:shadowDy="0.0"
        android:shadowRadius="2.0"
        android:textColor="#FFFFFFFF"
        android:id="@id/btnAlphaLarge"
            android:background="@drawable/textview_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/AlphaLarge"
            android:layout_weight="1.0" />
        <TextView
            android:gravity="center"
            android:shadowColor="#FF000000"
        android:shadowDx="0.0"
        android:shadowDy="0.0"
        android:shadowRadius="2.0"
        android:textColor="#FFFFFFFF"
        android:id="@id/btnAlphaSmall"
            android:background="@drawable/textview_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/AlphaSmall"
            android:layout_weight="1.0" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:shadowColor="#FF000000"
        android:shadowDx="0.0"
        android:shadowDy="0.0"
        android:shadowRadius="2.0"
        android:textColor="#FFFFFFFF"
        android:id="@id/btnInputClear"
            android:background="@drawable/textview_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/InputClear"
            android:layout_weight="1.0" />
        <TextView
            android:gravity="center"
            android:shadowColor="#FF000000"
        android:shadowDx="0.0"
        android:shadowDy="0.0"
        android:shadowRadius="2.0"
        android:textColor="#FFFFFFFF"
        android:id="@id/btnInputOK"
            android:background="@drawable/textview_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/InputOK"
            android:layout_weight="1.0" />
        <TextView
            android:gravity="center"
            android:shadowColor="#FF000000"
        android:shadowDx="0.0"
        android:shadowDy="0.0"
        android:shadowRadius="2.0"
        android:textColor="#FFFFFFFF"
        android:id="@id/btnInputCancel"
            android:background="@drawable/textview_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/InputCancel"
            android:layout_weight="1.0" />
    </LinearLayout>
</LinearLayout>